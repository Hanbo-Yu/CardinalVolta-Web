{
  "name": "cardinal-volta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build && node scripts/prerender.mjs",
    "format": "prettier --write src scripts index.html vite.config.js package.json README.md",
    "format:check": "prettier --check src scripts index.html vite.config.js package.json README.md",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "vite": "^8.3.0"
  }
}
